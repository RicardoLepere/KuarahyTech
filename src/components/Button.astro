---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'ghost-dark';
  size?: 'md' | 'xl';
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external = false, class: className = '' } = Astro.props;

const base =
  'inline-block font-display uppercase tracking-[1px] transition-[transform,box-shadow,background-color] duration-150 ease-in-out cursor-pointer border-pixel shadow-pixel-lg hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-pixel-xs';

const sizes = {
  md: 'text-[13px] px-[26px] py-4',
  xl: 'text-[15px] px-8 py-5',
};

const variants = {
  primary: 'bg-sol text-noche border-noche hover:bg-amanecer',
  ghost: 'bg-transparent text-noche dark:text-crema border-noche dark:border-crema hover:bg-white dark:hover:bg-panel',
  'ghost-dark': 'bg-transparent text-crema border-crema hover:bg-panel',
};
---

<a
  href={href}
  class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <slot />
</a>
