---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComingSoon from '../components/ComingSoon.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Areas from '../components/Areas.astro';
import Servicios from '../components/Servicios.astro';
import Productos from '../components/Productos.astro';
import Casos from '../components/Casos.astro';
import Nosotros from '../components/Nosotros.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import { COMING_SOON } from '../data/site';

const title = COMING_SOON
  ? 'Kuarahy Tech ▸ Pronto'
  : 'Kuarahy Tech ▸ Estudio de Software y Productos SaaS';
const description = 'Kuarahy Tech: estudio de software y productos SaaS en Paraguay. Webs, tiendas y sistemas que funcionan desde el día uno. Vos ponés la idea, nosotros el código.';
---

<BaseLayout title={title} description={description} noLoader={COMING_SOON}>
  {COMING_SOON ? (
    <ComingSoon />
  ) : (
    <>
      <Header />
      <main>
        <Hero />
        <Areas />
        <Servicios />
        <Productos />
        <Casos />
        <Nosotros />
        <Faq />
        <Contacto />
      </main>
      <Footer />
    </>
  )}
</BaseLayout>
